              ["APAC", "A", "Q2", 20],
              ["APAC", "B", "Q1", 5],
              ["EU", "A", "Q1", 7]
            ]
          },
          "rows": ["region", "product"],
          "columns": "quarter",
          "value": "revenue",
          "agg": "avg"
        }
      },
      {
