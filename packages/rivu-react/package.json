{
  "name": "rivu-react",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": ["./dist/tokens.css"],
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "scripts": {
    "build": "tsup && node -e \"require('fs').copyFileSync('src/tokens.css','dist/tokens.css')\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.7"
  },
  "peerDependencies":
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "rivu-kernel": "workspace:*",
    "rivu-ui-spec": "workspace:*",
    "zod": "^4.3.6"
  }
}
